<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- Bunker Mini Robot Properties -->
  <!-- Based on AgileX Bunker Mini specifications -->
  
  <!-- Base dimensions -->
  <xacro:property name="base_length" value="0.62" />
  <xacro:property name="base_width" value="0.52" />
  <xacro:property name="base_height" value="0.20" />
  <xacro:property name="base_mass" value="40" />
  
  <!-- Use simple geometry for base -->
  <xacro:property name="base_mesh_file" value="" />
  
  <!-- Wheel properties -->
  <xacro:property name="wheel_radius" value="0.0825" />  <!-- 165mm diameter / 2 -->
  <xacro:property name="wheel_width" value="0.08" />
  <xacro:property name="wheel_pos_x" value="0.0" />
  <xacro:property name="wheel_pos_y" value="0.23" />  <!-- 460mm track width / 2 -->
  <xacro:property name="wheel_pos_z" value="0.0" />
  <xacro:property name="wheel_mass" value="2.0" />
  <xacro:property name="wheel_torque" value="50" />
  
  <!-- Bunker Mini is 2WD, no caster wheels -->
  <xacro:property name="front_caster_wheel" value="false" />
  <xacro:property name="rear_caster_wheel" value="false" />
  
  <!-- Use simple geometry for wheels -->
  <xacro:property name="wheel_mesh_file" value="" />
  
  <!-- RPLIDAR A1 mounting position -->
  <!-- Measured: 40cm from ground, 9cm from front edge, centered on symmetry line -->
  <!-- base_link is at wheel center (8.25cm), so laser z = 40 - 8.25 = 31.75cm -->
  <!-- Front edge is at 31cm from center, so laser x = 31 - 9 = 22cm -->
  <xacro:property name="laser_pose">
    <origin xyz="0.22 0 0.3175" rpy="0 0 0"/>
  </xacro:property>

  <!-- Depth sensor mounting position (if used) -->
  <xacro:property name="depth_sensor_pose">
    <origin xyz="0.25 0.0 0.15" rpy="0 0 0"/>
  </xacro:property>
</robot>
